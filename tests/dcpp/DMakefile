#
# DMakefile for dcpp unit tests
#
# Paths are relative to this directory (tests/dcpp/) using AmigaDOS
# conventions:  /  = parent directory (one level up)
#               // = two levels up (project root)
#

CC     = dcc
UNITY  = //unity
CFLAGS = -I$(UNITY) -I//include -DUNITY_INCLUDE_CONFIG_H

all: test_ifexp

test_ifexp: test_ifexp.c $(UNITY)/unity.c
    $(CC) $(CFLAGS) -o test_ifexp test_ifexp.c $(UNITY)/unity.c

test: all
    test_ifexp

clean:
    -Delete test_ifexp
