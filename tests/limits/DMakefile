#
# DMakefile for limits.h unit tests
#
# Paths are relative to this directory (tests/limits/) using AmigaDOS
# conventions:  /  = parent directory (one level up)
#               // = two levels up (project root)
#

CC     = dcc
UNITY  = //unity
CFLAGS = -I$(UNITY) -I//include -DUNITY_INCLUDE_CONFIG_H

all: test_limits

test_limits: test_limits.c $(UNITY)/unity.c
    $(CC) $(CFLAGS) -o test_limits test_limits.c $(UNITY)/unity.c

test: all
    test_limits

clean:
    -Delete test_limits
